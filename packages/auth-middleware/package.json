{
  "name": "@ticketnest/auth-middleware",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Access-token verification shared by the gateway and every service: JWKS key resolution, the EdDSA verifier and the Express authenticate middleware.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./express": "./src/express/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ticketnest/contracts": "workspace:*",
    "@ticketnest/errors": "workspace:*",
    "@ticketnest/logger": "workspace:*",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ticketnest/eslint-config": "workspace:*",
    "@ticketnest/tsconfig": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
