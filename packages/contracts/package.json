{
  "name": "@ticketnest/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas shared across services and apps. In ./testing, the readers of the OpenAPI specs and of the default-role grants in docs/permissions.md that test code in several workspaces shares.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./common": "./src/common/index.ts",
    "./events": "./src/events/index.ts",
    "./testing": "./test/support/testing.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ticketnest/eslint-config": "workspace:*",
    "@ticketnest/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
