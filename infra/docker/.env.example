# Copy to infra/docker/.env (git-ignored) before running `pnpm infra:up`.
# These are local-development placeholders only. Never reuse them anywhere shared.

# Host ports (bound to 127.0.0.1). Change one if it clashes with a local install.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# PostgreSQL superuser (used only by the init script and admin tasks).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# One database and one login role per service. Role names are <database>_service.
# Passwords are applied only when the data volume is first created; use `pnpm infra:reset` to change them.
AUTH_DB_PASSWORD=change-me-auth
CATALOG_DB_PASSWORD=change-me-catalog
BOOKING_DB_PASSWORD=change-me-booking
PAYMENT_DB_PASSWORD=change-me-payment
NOTIFICATION_DB_PASSWORD=change-me-notification

REDIS_PASSWORD=change-me-redis

RABBITMQ_USER=ticketnest
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=ticketnest
