# Copy to services/auth-service/.env (git-ignored) for `pnpm --filter @ticketnest/auth-service dev`.
# Local-development placeholders only; they match infra/docker/.env.example.
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug

DATABASE_URL=postgres://auth_service:change-me-auth@localhost:5432/auth
REDIS_URL=redis://:change-me-redis@localhost:6379

# Comma-separated browser origins allowed by CORS. Empty denies all (the gateway is the only caller).
CORS_ORIGINS=
JSON_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Access-token signing key (EdDSA / Ed25519). Names only here: never commit a real key.
# Generate your own for local development:
#   openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
# JWT_PRIVATE_KEY is the base64 of the PKCS#8 PEM. Production reads it from the secret manager.
JWT_PRIVATE_KEY=
JWT_KEY_ID=local-dev-1
JWT_ISSUER=http://localhost:4001
JWT_AUDIENCE=ticketnest-api

# Grace window for refresh-token reuse, in ms (0 to 30000, default 10000). A replay of a token
# rotated less than this long ago is answered with 401 but does NOT revoke the session. 0 = strict.
REFRESH_REUSE_GRACE_MS=10000
