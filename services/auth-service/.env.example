# Copy to services/auth-service/.env (git-ignored) for `pnpm --filter @ticketnest/auth-service dev`.
# Names and non-secret defaults only. Fill in the values marked below from infra/docker/.env.
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug

# Format: postgres://auth_service:<AUTH_DB_PASSWORD>@localhost:5432/auth
DATABASE_URL=
# Format: redis://:<REDIS_PASSWORD>@localhost:6379
REDIS_URL=

# Comma-separated browser origins allowed by CORS. Empty denies all (the gateway is the only caller).
CORS_ORIGINS=
JSON_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Access-token signing key (EdDSA / Ed25519). Names only here: never commit a real key.
# Generate your own for local development:
#   openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
# JWT_PRIVATE_KEY is the base64 of the PKCS#8 PEM. Production reads it from the secret manager.
JWT_PRIVATE_KEY=
# Optional. Comma-separated base64 SPKI PEMs of verify-only public keys (see docs/runbooks/jwt-key-rotation.md).
JWT_ADDITIONAL_PUBLIC_KEYS=
JWT_ISSUER=http://localhost:4001
JWT_AUDIENCE=ticketnest-api

# Grace window for refresh-token reuse, in ms (0 to 30000, default 10000). A replay of a token
# rotated less than this long ago is answered with 401 but does NOT revoke the session. 0 = strict.
REFRESH_REUSE_GRACE_MS=10000

# Secret mixed into the rate-limit keys of emails and refresh tokens, so Redis never holds either in
# plaintext. At least 32 characters. Names only here: never commit a real value. Generate your own:
#   openssl rand -base64 32
RATE_LIMIT_KEY_PEPPER=
# Reverse proxies in front of the service whose X-Forwarded-For is trusted for the client IP (0 to 10).
# 0 = clients reach the service directly (the socket address is used, so the IP cannot be spoofed).
# Set 1 once the service sits behind the gateway.
TRUST_PROXY_HOPS=0
