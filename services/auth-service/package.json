{
  "name": "@ticketnest/auth-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Users, roles, tokens and guest access. Skeleton only: health endpoints, no business routes yet.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --external:pg-native --outfile=dist/server.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ticketnest/config": "workspace:*",
    "@ticketnest/errors": "workspace:*",
    "@ticketnest/logger": "workspace:*",
    "cors": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ticketnest/eslint-config": "workspace:*",
    "@ticketnest/tsconfig": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
