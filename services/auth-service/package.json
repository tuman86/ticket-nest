{
  "name": "@ticketnest/auth-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Users, roles, tokens and guest access. Skeleton, database schema, repositories and POST /v1/auth/register.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --external:pg-native --define:import.meta.url=__importMetaUrl --banner:js=\"const __importMetaUrl = require('node:url').pathToFileURL(__filename).href;\" --outfile=dist/server.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@ticketnest/auth-middleware": "workspace:*",
    "@ticketnest/config": "workspace:*",
    "@ticketnest/contracts": "workspace:*",
    "@ticketnest/errors": "workspace:*",
    "@ticketnest/logger": "workspace:*",
    "@ticketnest/messaging": "workspace:*",
    "@ticketnest/rate-limit": "workspace:*",
    "@ticketnest/service-runtime": "workspace:*",
    "cors": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@ticketnest/eslint-config": "workspace:*",
    "@ticketnest/tsconfig": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
