# Copy to services/api-gateway/.env (git-ignored) for `pnpm --filter @ticketnest/api-gateway dev`.
# Names and non-secret defaults only. Fill in the values marked below from infra/docker/.env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Rate-limit counters only. The gateway has no database.
# Format: redis://:<REDIS_PASSWORD>@localhost:6379 (the password is in infra/docker/.env).
REDIS_URL=

# Must match auth-service's JWT_ISSUER and JWT_AUDIENCE. The gateway holds no private key: it
# fetches the public keys from AUTH_SERVICE_URL/.well-known/jwks.json.
JWT_ISSUER=http://localhost:4001
JWT_AUDIENCE=ticketnest-api

# Base URLs (origin only, no path) of the services behind the gateway. Production needs https://
# unless ALLOW_INSECURE_UPSTREAMS=true (only for a private network such as the compose network).
AUTH_SERVICE_URL=http://localhost:4001
# Placeholder port: catalog-service is not built yet (confirm when it is scaffolded).
CATALOG_SERVICE_URL=http://localhost:4002

# Reverse proxies in front of the gateway whose X-Forwarded-For is trusted for the client IP (0 to 10).
# 0 = clients reach the gateway directly (the socket address is used, so the IP cannot be spoofed).
# Set 1 behind an ALB. Services behind the gateway keep TRUST_PROXY_HOPS=1.
TRUST_PROXY_HOPS=0

# Comma-separated browser origins allowed by CORS (the web and console apps). Empty denies all.
# Example: CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=

# Largest request body forwarded, in bytes (default 1 MiB).
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
ALLOW_INSECURE_UPSTREAMS=false
